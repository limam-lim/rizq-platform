# تبعيات Node — تُعاد بالكامل عبر npm install على السيرفر، لا تُرفع أبداً
node_modules/
rizq-backend/node_modules/

# متغيرات البيئة (أسرار: توكنات واتساب، بريد، Twilio، المفاتيح السرية)
.env
.env.*
!.env.example
!**/.env.example
!**/.env.production.example
rizq-backend/.env

# نسخ Postgres المشفّرة (scripts/backup-db.sh)
backups/db/
backups/db-*/

# بيانات المستخدمين الفعلية وقت التشغيل (حسابات، إعلانات، رسائل، تقييمات...)
# — لا تُرفع أبداً لأي مستودع، حتى خاص: بيانات شخصية حقيقية بعد الانطلاق،
# وليست جزءاً من الكود المصدري. تُنشأ تلقائياً من server.js عند أول تشغيل.
rizq-backend/data/

# نسخ احتياطية ومسودات عمل داخلية — للأرشفة المحلية فقط
_backup_*/
_archive/
_maintenance/

# ملفات نظام التشغيل والمحررات
.DS_Store
Thumbs.db
*.log
rizq-backend/_probe_delete_me.json

# Local GitHub-matching code archives (meta committed; tarballs stay local)
backups/*.tar.gz
backups/*.sha256

# لقطات/تقارير fix-ui-logic-1 محلية فقط
qa/ui-logic-1/*.png
qa/ui-logic-1/console-*.json
qa/ui-logic-1/*-report.json
qa/ui-logic-1/node_modules/
qa/ui-logic-1/package-lock.json
