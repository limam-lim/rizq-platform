# ═══════════════════════════════════════════════════════════
# رزق / Rizq — متغيرات البيئة (مثال للإنتاج)
# انسخ إلى .env واملأ القيم الحقيقية. لا ترفع .env إلى Git أبداً.
# ═══════════════════════════════════════════════════════════

NODE_ENV=production
RIZQ_ENV=production
PORT=3000

# ── أسرار الخادم / المصادقة بين الخدمات ───────────────────
RIZQ_API_SECRET=change-me-long-random-hex
BACKEND_SHARED_SECRET=change-me-another-long-random-hex
ALLOWED_ORIGIN=https://rizq.mr,https://www.rizq.mr

# ── حسابات الأدمن (هاشات bcrypt فقط — بلا كلمات مرور نصية) ─
# توليد الهاش:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
ADMIN_ACCOUNTS_JSON=[{"user":"admin","passHash":"$2a$10$REPLACE_WITH_BCRYPT_HASH","name":"Admin","role":"super"}]
# أو:
# ADMIN_USER_1=admin
# ADMIN_PASS_HASH_1=$2a$10$...
# ADMIN_NAME_1=Admin
# ADMIN_ROLE_1=super
# ADMIN_DEV_ACCOUNTS_JSON=  # للتطوير فقط — يُتجاهل في الإنتاج

# ── بوابة لوحة الأدمن (اختياري) ───────────────────────────
# ADMIN_PANEL_PATH=/admin-secret-path
# ADMIN_PANEL_GATE_KEY=
# ADMIN_PANEL_IP_ALLOWLIST=
# ADMIN_PANEL_BLOCK_LEGACY=1

# ── AI (Anthropic Claude) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_API_KEY=

# ── Twilio (مكالمات / SMS / توقيع الويبهوك) ───────────────
TWILIO_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_TOKEN=...
TWILIO_WEBHOOK_BASE_URL=https://your-api-domain.example
RIZQ_TWILIO_NUMBER=+1...
RIZQ_ADMIN_PHONE=+222...

# ── كلمات مرور البائعين ───────────────────────────────────
BCRYPT_ROUNDS=10

# ── إيصالات الدفع اليدوي ──────────────────────────────────
RECEIPT_MAX_BYTES=5242880

# ── OTP / جلسات المشترين ──────────────────────────────────
# OTP_PEPPER=
# JWT_SECRET=change-me-jwt
# DATABASE_URL=sqlite:./rizq-backend/data/rizq.db

# ── Telegram (تنبيهات الإدارة) ────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

# ── روابط ─────────────────────────────────────────────────
# RIZQ_BACKEND_URL=https://api.rizq.mr
# PUBLIC_BASE_URL=https://rizq.mr
