# الحارس — انسخ إلى services/sentinel/.env أو أضف إلى rizq-backend/.env

# اتصال بدور القراءة فقط (يُفضَّل)
# SENTINEL_DATABASE_URL=postgres://rizq_sentinel:CHANGE_ME@127.0.0.1:5432/rizq
# أو:
SENTINEL_DB_PASSWORD=CHANGE_ME
# DATABASE_URL=postgres://rizq:...@127.0.0.1:5432/rizq

SENTINEL_WAKE_SECRET=
# أو يشارك BACKEND_SHARED_SECRET

PUBLIC_BASE_URL=https://rizq.mr
SENTINEL_BACKEND_URL=http://127.0.0.1:3000
SENTINEL_LISTEN_PORT=3017
SENTINEL_TZ=Europe/Madrid

SENTINEL_TELEGRAM_BOT_TOKEN=
SENTINEL_TELEGRAM_CHAT_ID=
# توجيه رسائل telegramAdmin عبر الحارس
SENTINEL_TELEGRAM_BRIDGE=1

ANTHROPIC_API_KEY=
SENTINEL_DAILY_TOKEN_BUDGET=50000

BACKUP_DB_DIR=/opt/rizq/backups/db
SENTINEL_CADDY_ACCESS_LOG=/var/log/caddy/access.log
SENTINEL_DOMAIN_EXPIRY=
# CLOUDFLARE_ANALYTICS_TOKEN=
# CLOUDFLARE_ZONE_ID=

SENTINEL_ACCOUNT_EMAIL=sentinel@rizq.mr
# SENTINEL_ACCOUNT_PASSWORD=
