{
  "name": "rizq-agents",
  "version": "1.0.0",
  "description": "خوادم وكلاء رزق (مكالمات Twilio، واتساب Meta Cloud API، وكيل دورة حياة الباقات) — منفصلة عن rizq-backend/ الذي له package.json خاص به",
  "main": "rizq_call_handler.js",
  "type": "commonjs",
  "scripts": {
    "start": "npm --prefix rizq-backend start",
    "start:platform": "npm --prefix rizq-backend start",
    "start:static": "npx --yes serve -l 3000 .",
    "start:call": "node rizq_call_handler.js",
    "start:whatsapp": "node rizq_whatsapp_handler.js",
    "sync-index": "node -e \"require('fs').writeFileSync('index.html', '<!DOCTYPE html>\\n<html lang=\\\"ar\\\" dir=\\\"rtl\\\">\\n<head>\\n<meta charset=\\\"UTF-8\\\"/>\\n<meta http-equiv=\\\"refresh\\\" content=\\\"0;url=rizq_landing_v8.html\\\"/>\\n<link rel=\\\"canonical\\\" href=\\\"https://rizq.mr/rizq_landing_v8.html\\\"/>\\n<title>رزق | Rizq</title>\\n<script>(function(){var q=location.search||\\\"\\\";var h=location.hash||\\\"\\\";location.replace(\\\"rizq_landing_v8.html\\\"+q+h);})();<\\\\/script>\\n</head><body><a href=\\\"rizq_landing_v8.html\\\">رزق</a></body></html>\\n')\"",
    "dev": "npm --prefix rizq-backend start",
    "dev:split": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "dev:front": "npx --yes serve -l 5500 .",
    "dev:api": "npm --prefix rizq-backend run dev",
    "test:links": "node scripts/audit-platform-links.js",
    "test:smoke": "node scripts/e2e-platform-smoke.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "axios": "^1.7.7",
    "body-parser": "^1.20.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "twilio": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
