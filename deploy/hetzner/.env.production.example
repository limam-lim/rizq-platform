# مثال إنتاج Hetzner — انسخ إلى rizq-backend/.env واملأ الأسرار محلياً.
# لا تضع قيماً سرية في هذا الملف.

NODE_ENV=production
DB_DRIVER=postgres
DATABASE_URL=postgres://rizq:CHANGE_ME@127.0.0.1:5432/rizq
RUN_MIGRATIONS_ON_BOOT=1

# خلف Cloudflare + Caddy
TRUST_CLOUDFLARE=1
TRUST_PROXY=1
ALLOWED_ORIGIN=https://rizq.mr
PUBLIC_BASE_URL=https://rizq.mr

BACKEND_SHARED_SECRET=
RIZQ_API_SECRET=
ADMIN_PANEL_PATH=cp-change-me
ADMIN_PANEL_GATE_KEY=
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_USER=owner@example.com
SUPER_ADMIN_PASS_HASH=
# مفتاح TOTP لـ 2FA الأدمن (لا قيمة هنا)
ADMIN_2FA_KEY=

ANTHROPIC_API_KEY=
# مهلات خارجية (افتراضي 15ث)
EXTERNAL_HTTP_TIMEOUT_MS=15000
EXTERNAL_HTTP_MAX_RETRIES=1
ANTHROPIC_TIMEOUT_MS=15000
ANTHROPIC_MAX_RETRIES=1
TELEGRAM_TIMEOUT_MS=15000
FACEBOOK_TIMEOUT_MS=15000
SMTP_TIMEOUT_MS=15000
IMAGES_TIMEOUT_MS=15000

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="رزق Rizq <direction@rizq.mr>"

# لا تنسخ JSON عند كل كتابة في الإنتاج
DEV_JSON_DUMPS=0

# نسخ احتياطي Postgres (scripts/backup-db.sh)
BACKUP_DB_DIR=/opt/rizq/backups/db
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# age: BACKUP_AGE_RECIPIENT=age1...
# أو gpg: BACKUP_GPG_RECIPIENT=ops@rizq.mr
# أو: BACKUP_GPG_PASSPHRASE=
# RCLONE_REMOTE=b2:rizq-backups

# نسخ الملفات (backupService الموجود)
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=/opt/rizq/backups/files
BACKUP_RETENTION_DAYS=30

REDIS_ENABLED=0
REDIS_URL=

# ── الحارس (Sentinel) ──
SENTINEL_DB_PASSWORD=
SENTINEL_WAKE_SECRET=
SENTINEL_LISTEN_PORT=3017
SENTINEL_TELEGRAM_BOT_TOKEN=
SENTINEL_TELEGRAM_CHAT_ID=
SENTINEL_TELEGRAM_BRIDGE=1
SENTINEL_DAILY_TOKEN_BUDGET=50000
SENTINEL_TZ=Europe/Madrid
SENTINEL_DOMAIN_EXPIRY=
SENTINEL_CADDY_ACCESS_LOG=/var/log/caddy/access.log
SENTINEL_ACCOUNT_EMAIL=sentinel@rizq.mr
# CLOUDFLARE_ANALYTICS_TOKEN=
# CLOUDFLARE_ZONE_ID=
