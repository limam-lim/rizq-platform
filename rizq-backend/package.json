{
  "name": "rizq-backend",
  "version": "1.0.0",
  "description": "خادم خلفي آمن لمنصة رزق — يحمل مفاتيح API على السيرفر فقط (لا تصل أبداً لكود الواجهة الأمامية الثابت)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "backup": "node scripts/run-backup.js",
    "migrate": "node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations --database-url-var DATABASE_URL",
    "migrate:down": "node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations --database-url-var DATABASE_URL",
    "migrate:sqlite-to-pg": "node -r dotenv/config scripts/migrate-sqlite-to-postgres.js",
    "fixture:sqlite": "node scripts/build-sqlite-migration-fixture.js",
    "test:pg-repos": "node scripts/run-with-test-db.js scripts/test-pg-repos.js",
    "test:backup": "node scripts/run-with-test-db.js scripts/test-backup-restore.js",
    "test:lifecycle": "node scripts/run-with-test-db.js scripts/test-ad-lifecycle.js",
    "test:ops": "node scripts/run-with-test-db.js scripts/test-ops-housekeeping.js",
    "test:prefix": "node scripts/run-with-test-db.js scripts/test-delete-prefix-isolation.js",
    "test:images": "node scripts/run-with-test-db.js scripts/test-image-pipeline.js",
    "test:widget-lang": "node scripts/run-with-test-db.js scripts/test-widget-lang.js",
    "telegram:poll": "node scripts/telegram-polling-dev.js",
    "telegram:webhook": "node scripts/setup-telegram-webhook.js",
    "test:hardening": "node scripts/run-with-test-db.js scripts/test-prod-hardening.js",
    "provision:admin": "node scripts/provision-secret-admin.js",
    "test:admin-roles": "node scripts/run-with-test-db.js scripts/test-admin-roles.js",
    "verify:agents": "node scripts/verify-claude-agents.js",
    "verify:claude": "node scripts/verify-claude-agents.js",
    "seed:graduation": "node scripts/seed-graduation-demo.js",
    "seed:graduation:clear": "node scripts/seed-graduation-demo.js --clear",
    "purge:demo": "node scripts/purge-demo.js",
    "purge:demo:confirm": "node scripts/purge-demo.js --confirm",
    "launch:check": "node scripts/launch-check.js",
    "test:await": "node scripts/run-with-test-db.js scripts/check-unawaited-async.js",
    "test:async-regressions": "node scripts/run-with-test-db.js scripts/test-async-regressions.js",
    "test:kyc": "node scripts/run-with-test-db.js scripts/test-kyc-access.js",
    "test:2fa": "node scripts/run-with-test-db.js scripts/test-admin-2fa.js",
    "test:sessions": "node scripts/run-with-test-db.js scripts/test-sessions-concurrency.js",
    "test:contact-scrub": "node scripts/run-with-test-db.js scripts/test-contact-scrub.js",
    "test:register-sync-fail": "node scripts/run-with-test-db.js scripts/test-register-sync-fail.js",
    "test:verify-dash-pending": "node scripts/run-with-test-db.js scripts/test-verify-dash-pending.js",
    "test:launch-demo": "node scripts/run-with-test-db.js scripts/test-launch-demo-gate.js",
    "test:a1-launch": "node scripts/run-with-test-db.js scripts/test-a1-launch-config-api.js",
    "test:quota-concurrency": "node scripts/run-with-test-db.js scripts/test-quota-concurrency.js",
    "test:packages-b14": "node scripts/run-with-test-db.js scripts/test-packages-b14-receipt-b16.js",
    "test:packages-core": "node scripts/run-with-test-db.js scripts/test-packages-b6-b3-b8-trial.js",
    "test:package-period": "node scripts/run-with-test-db.js scripts/test-package-period-history.js",
    "test:lifecycle-save": "node scripts/run-with-test-db.js scripts/test-lifecycle-concurrent-save.js",
    "test:trial-once": "node scripts/run-with-test-db.js scripts/test-trial-once.js",
    "test:browse": "node scripts/run-with-test-db.js scripts/test-browse-infinite-and-cards.js",
    "admin:2fa": "node scripts/admin-2fa.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "ioredis": "^6.0.0",
    "node-cron": "^4.6.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.1.7",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "tar": "^7.4.3",
    "twilio": "^5.13.1"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.679.0",
    "ssh2-sftp-client": "^11.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4"
  }
}
