# انسخ إلى .env وعدّل القيم — لا ترفع .env للمستودع
ANTHROPIC_API_KEY=
ALLOWED_ORIGIN=http://localhost:3000
BACKEND_SHARED_SECRET=
PUBLIC_BASE_URL=http://localhost:3000

# ── وضع الإطلاق التدريجي ──────────────────────────────────
# أقسام مفتوحة فقط (الباقي يظهر بشارة «قريباً» + سجّل اهتمامك)
RIZQ_OPEN_SECTIONS=stores,estate,individual
# نهاية الفترة المجانية (YYYY-MM-DD) — بعدها يعود إخفاء الأرقام للباقات المدفوعة
RIZQ_LAUNCH_FREE_UNTIL=2026-12-31
# خصم الشريك المؤسس بعد انتهاء المجانية (٪)
RIZQ_FOUNDING_DISCOUNT_PERCENT=40

# لوحة السوبر أدمن (مسار خفي)
ADMIN_PANEL_PATH=cp-change-me
ADMIN_PANEL_GATE_KEY=change-me-long-random
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_NAME=Owner
SUPER_ADMIN_USER=owner@example.com
# bcrypt فقط — ولّد الهاش محلياً ثم الصقه هنا:
#   cd rizq-backend && node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
SUPER_ADMIN_PASS_HASH=
# اختياري: 1 = أعد فرض هاش .env عند كل إقلاع (يمسح أي كلمة سر غيّرتها من اللوحة)
# SUPER_ADMIN_FORCE_PASS_HASH=0

# غرفة الاستثمارات — بريد تشغيلي خاص (لا يُعرض في الواجهة العامة)
# الافتراضي: SUPER_ADMIN_EMAIL إن تُرك فارغاً. البريد العام للمنصة يبقى contact@rizq.mr
# INVESTMENT_OPS_EMAIL=
# OWNER_OPS_EMAIL=
# INVESTMENT_OPS_REPORT=1
# INVESTMENT_OPS_INTERVAL_MS=86400000

# موافقة مبدئية تلقائية للوكلاء (استثمار + باقات): 1=أخضر يُعتمد مبدئياً، أصفر/أحمر يعلّق لك
# PROVISIONAL_AUTO_APPROVE=1

# اختياري Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

# نسخ احتياطي مشفّر (64 hex) — مطلوب لـ npm run backup / cron
BACKUP_ENCRYPTION_KEY=
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=30

# ── PostgreSQL (مطلوب عند DB_DRIVER=postgres) ──────────────
# لا تضع كلمات مرور افتراضية هنا — عبّئها محلياً / في أسرار النشر.
DB_DRIVER=postgres
DATABASE_URL=postgres://rizq:@127.0.0.1:5432/rizq
# PG_POOL_MAX=20
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECT_TIMEOUT_MS=10000
# PGSSL=false
# RUN_MIGRATIONS_ON_BOOT=1

# ── Redis (اختياري — المنصة تعمل بذاكرة محلية إن تعطّل) ───
# REDIS_ENABLED=1 يفعّل المحاولة؛ REDIS_URL يجب أن يتضمن كلمة المرور إن وُجدت:
#   redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379
REDIS_URL=
REDIS_ENABLED=1
# REDIS_KEY_PREFIX=rizq:

# ── الحارس Sentinel (عملية services/sentinel مستقلة) ──
# SENTINEL_DB_PASSWORD=
# SENTINEL_WAKE_SECRET=   # إلزامي للإيقاظ — بلا fallback إلى BACKEND_SHARED_SECRET
# SENTINEL_LISTEN_PORT=3017
# SENTINEL_TELEGRAM_CHAT_ID=
# SENTINEL_TELEGRAM_BRIDGE=1
# SENTINEL_DAILY_TOKEN_BUDGET=50000
# SENTINEL_TZ=Europe/Madrid
# SENTINEL_DOMAIN_EXPIRY=
# SENTINEL_ACCOUNT_EMAIL=sentinel@rizq.mr
