# ═══════════════════════════════════════════════════════════
# رزق / Rizq — متغيرات البيئة (مثال للإنتاج)
# انسخ إلى .env واملأ القيم الحقيقية. لا ترفع .env إلى Git أبداً.
# ═══════════════════════════════════════════════════════════

NODE_ENV=production
RIZQ_ENV=production
PORT=3000

# ── أسرار الخادم / المصادقة بين الخدمات ───────────────────
RIZQ_API_SECRET=change-me-long-random-hex
BACKEND_SHARED_SECRET=change-me-another-long-random-hex
ALLOWED_ORIGIN=https://rizq.mr,https://www.rizq.mr

# ── حسابات الأدمن (هاشات bcrypt فقط — بلا كلمات مرور نصية) ─
# الأفضل محلياً: توليد مسار سري + بوابة + حساب سوبر أدمن دفعة واحدة:
#   node scripts/provision-secret-admin.js
#   node scripts/provision-secret-admin.js --user m.limam --name "M. LIMAM"
# توليد هاش يدوياً:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
# ADMIN_ACCOUNTS_JSON=[{"user":"admin","passHash":"$2a$10$REPLACE_WITH_BCRYPT_HASH","name":"Admin","role":"super"}]
ADMIN_USER_1=m.limam
ADMIN_PASS_HASH_1=$2a$12$REPLACE_WITH_BCRYPT_HASH
ADMIN_NAME_1=M. LIMAM
ADMIN_ROLE_1=super
# زملاء بصلاحيات مختلفة (نفس المسار السري — حسابات منفصلة):
# node scripts/provision-secret-admin.js --add --user finance.desk --role finance --name "مراقب مالي"
# node scripts/provision-secret-admin.js --add --user commercial.desk --role commercial --name "مسؤول تجاري"
# ADMIN_USER_2=finance.desk
# ADMIN_PASS_HASH_2=$2a$12$...
# ADMIN_NAME_2=مراقب مالي
# ADMIN_ROLE_2=finance
# ADMIN_USER_3=commercial.desk
# ADMIN_PASS_HASH_3=$2a$12$...
# ADMIN_NAME_3=مسؤول تجاري
# ADMIN_ROLE_3=commercial
# الأدوار: super | admin | commercial | finance | moderator | support
# ADMIN_DEV_ACCOUNTS_JSON=  # للتطوير فقط — يُتجاهل في الإنتاج

# ── بوابة لوحة الأدمن (مسار سري مشترك لكل الأدوار) ───────
# بدون ADMIN_PANEL_PATH في الإنتاج: اللوحة غير متاحة عبر HTTP
# الرابط الكامل: https://domain/ADMIN_PANEL_PATH?k=ADMIN_PANEL_GATE_KEY
ADMIN_PANEL_PATH=cp-REPLACE_WITH_RANDOM_HEX
ADMIN_PANEL_GATE_KEY=REPLACE_WITH_LONG_RANDOM
# ADMIN_PANEL_IP_ALLOWLIST=
ADMIN_PANEL_BLOCK_LEGACY=1

# ── AI (Anthropic Claude) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# الصق BACKEND_SHARED_SECRET أيضاً في لوحة التحكم → وكيل الباقات
# CLAUDE_API_KEY=

# ── Twilio (مكالمات / SMS / توقيع الويبهوك) ───────────────
TWILIO_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_TOKEN=...
TWILIO_WEBHOOK_BASE_URL=https://your-api-domain.example
RIZQ_TWILIO_NUMBER=+1...
RIZQ_ADMIN_PHONE=+222...

# ── كلمات مرور البائعين ───────────────────────────────────
BCRYPT_ROUNDS=10

# ── إيصالات الدفع اليدوي ──────────────────────────────────
RECEIPT_MAX_BYTES=5242880

# ── OTP / جلسات المشترين ──────────────────────────────────
# OTP_PEPPER=
# JWT_SECRET=change-me-jwt
# DATABASE_URL=sqlite:./rizq-backend/data/rizq.db

# ── Telegram (تنبيهات الإدارة) ────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

# ── روابط ─────────────────────────────────────────────────
# RIZQ_BACKEND_URL=https://api.rizq.mr
# PUBLIC_BASE_URL=https://rizq.mr
