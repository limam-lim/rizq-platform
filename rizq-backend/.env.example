# انسخ إلى .env وعدّل القيم — لا ترفع .env للمستودع
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# ── Database driver ───────────────────────────────────────
# sqlite (تطوير محلي) | postgres|pg (إنتاج Docker)
DB_DRIVER=postgres
# إما DATABASE_URL أو متغيرات PG* المنفصلة
DATABASE_URL=postgres://rizq:rizq_change_me@postgres:5432/rizq
# PGHOST=postgres
# PGPORT=5432
# PGDATABASE=rizq
# PGUSER=rizq
# PGPASSWORD=rizq_change_me
PG_POOL_MAX=20
# PGSSL=false

# ── Redis (rate-limit + sessions + cache) ─────────────────
REDIS_URL=redis://redis:6379
REDIS_ENABLED=1
REDIS_KEY_PREFIX=rizq:
CACHE_TTL_SECONDS=60

# ── أسرار المنصة ──────────────────────────────────────────
ANTHROPIC_API_KEY=
ALLOWED_ORIGIN=https://rizq.mr,https://www.rizq.mr,https://rizqsmart.com,https://www.rizqsmart.com
BACKEND_SHARED_SECRET=change-me-another-long-random-hex
RIZQ_API_SECRET=change-me-long-random-hex
PUBLIC_BASE_URL=https://rizq.mr
OTP_PEPPER=change-me-otp-pepper

# لوحة السوبر أدمن (مسار خفي)
ADMIN_PANEL_PATH=cp-change-me
ADMIN_PANEL_GATE_KEY=change-me-long-random
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_NAME=Owner
SUPER_ADMIN_USER=owner@example.com
# bcrypt فقط — ولّد الهاش محلياً ثم الصقه هنا:
#   cd rizq-backend && node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
SUPER_ADMIN_PASS_HASH=
# SUPER_ADMIN_FORCE_PASS_HASH=0

# تخزين الوسائط: local | s3
RIZQ_STORAGE_DRIVER=local

# غرفة الاستثمارات
# INVESTMENT_OPS_EMAIL=
# OWNER_OPS_EMAIL=
# INVESTMENT_OPS_REPORT=1
# INVESTMENT_OPS_INTERVAL_MS=86400000
# PROVISIONAL_AUTO_APPROVE=1

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=
